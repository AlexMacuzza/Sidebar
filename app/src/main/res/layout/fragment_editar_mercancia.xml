<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_editar_mercancia"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".EditarMercanciaFragment">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/titulo7"
        android:gravity="center"
        android:textSize="20sp"
        android:textStyle="bold"/>
    <TextView
        android:id="@+id/lblidp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/lblidmerc"
        android:textSize="17sp"
        android:textStyle="bold" />
    <EditText
        android:id="@+id/txtdesc"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="@string/txtdesc"
        android:textColorHint="#546E7A"
        android:inputType="text"
        tools:ignore="Autofill" />
    <EditText
        android:id="@+id/txtprecioc"
        android:layout_width="150dp"
        android:layout_height="48dp"
        android:hint="@string/txtprecioc"
        android:inputType="number"
        android:maxLength="10"
        android:textColorHint="#546E7A"
        tools:ignore="Autofill" />
    <EditText
        android:id="@+id/txtpreciov"
        android:layout_width="150dp"
        android:layout_height="48dp"
        android:hint="@string/txtpreciov"
        android:inputType="number"
        android:maxLength="10"
        android:textColorHint="#546E7A"
        tools:ignore="Autofill" />
    <EditText
        android:id="@+id/txtcantidad"
        android:layout_width="150dp"
        android:layout_height="48dp"
        android:hint="@string/txtcantidad"
        android:inputType="number"
        android:maxLength="10"
        android:textColorHint="#546E7A"
        tools:ignore="Autofill" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/bteditar"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_alignParentStart="true"
            android:layout_marginStart="51dp"
            android:background="@null"
            android:gravity="center"
            android:contentDescription="@string/lbleditar"
            android:scaleType="centerCrop"
            android:src="@drawable/aceptar" />
        <ImageButton
            android:id="@+id/bteliminar"
            android:layout_width="53dp"
            android:layout_height="50dp"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="98dp"
            android:background="@null"
            android:contentDescription="@string/lbleliminar"
            android:gravity="center"
            android:scaleType="centerCrop"
            android:src="@drawable/eliminar" />
    </RelativeLayout>

</LinearLayout>