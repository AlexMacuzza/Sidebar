<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_actventa"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ActualizarVentasFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="4dp">
        <!-- ── Título ─────────────────────────────────────────────── -->
        <TextView
            android:id="@+id/lblvd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/lblvendedor_titulo"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/teal_700"
            android:visibility="gone" />
        <!-- ── Sección: Buscar factura ────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/lblnumventa_titulo"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Caja para ingresar el número de factura -->
            <EditText
                android:id="@+id/txtNumVenta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:hint="@string/hint_num_venta"
                android:imeOptions="actionSearch"
                android:inputType="number"
                android:maxLength="10"
                tools:ignore="Autofill" />

            <!-- Botón buscar factura -->
            <ImageButton
                android:id="@+id/btnBuscarVenta"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@null"
                android:contentDescription="@string/desc_buscar_venta"
                android:scaleType="centerCrop"
                android:src="@drawable/buscarcliente"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Cliente asociado a la venta (solo lectura) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lblcliente_actventa"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtidcl"
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:hint="@string/hint_id_cliente"
                android:enabled="false"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtcliente"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="@string/hint_nombre_cliente"
                android:enabled="false"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/teal_700" />

        <!-- ── Sección: Agregar Productos ─────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/lblagregarproductos"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnmercancia"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginEnd="8dp"
                android:background="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/buscarmercancia"
                android:contentDescription="@string/desc_agregar_mercancia" />
        </LinearLayout>

        <!-- RecyclerView de productos de la venta -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/idRecycler"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:scrollbars="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/teal_700" />

        <!-- ── Sección: Subtotales ────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/lblsubtotales"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/txtventat"
                android:text="@string/lbltotalventa"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/txtvpagado"
                android:text="@string/lblvalorpagadoventa"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/txtsaldo"
                android:text="@string/lblsaldoventa"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/txtventat"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="10" />

            <EditText
                android:id="@+id/txtvpagado"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:maxLength="10"
                android:textColorHint="#546E7A"
                tools:ignore="Autofill" />

            <EditText
                android:id="@+id/txtsaldo"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:inputType="number"
                android:maxLength="10"
                android:textColorHint="#546E7A"
                tools:ignore="Autofill,SpeakableTextPresentCheck" />

            <ImageButton
                android:id="@+id/btnborrar"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:background="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/delete"
                android:contentDescription="@string/desc_limpiar"
                tools:ignore="TouchTargetSizeCheck" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/teal_700" />

        <!-- ── Sección: Cuotas y Fechas ───────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/lblcuotasfechascobro"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/spnrfpago"
                android:text="@string/lblformapago"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:labelFor="@id/txtctanormal"
                android:text="@string/lblvalorcuota_form"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/txtnctas"
                android:text="@string/lblcuotasventa"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/spnrfpago"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:entries="@array/options_fpago"
                tools:ignore="TouchTargetSizeCheck" />

            <EditText
                android:id="@+id/txtctanormal"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="10" />

            <EditText
                android:id="@+id/txtnctas"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:importantForAutofill="no"
                android:inputType="number" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/txtfechav"
                android:text="@string/lblvencimiento"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/txtfechacobro"
                android:text="@string/lblfechacobroventa"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lblobs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/txtobs"
                android:text="@string/lblobservacionesventa"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/txtfechav"
                android:layout_width="120dp"
                android:layout_height="48dp"
                android:enabled="false"
                android:importantForAutofill="no"
                android:inputType="text" />

            <EditText
                android:id="@+id/txtfechacobro"
                android:layout_width="120dp"
                android:layout_height="48dp"
                android:clickable="true"
                android:focusable="false"
                android:importantForAutofill="no"
                android:inputType="date"
                android:hint="@string/hint_fecha_cobro" />

            <EditText
                android:id="@+id/txtobs"
                android:layout_width="150dp"
                android:layout_height="48dp"
                android:focusable="true"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="text"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/teal_700" />

        <!-- ── Botón guardar ──────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btregistrarv"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginEnd="16dp"
                android:background="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/aceptar"
                android:contentDescription="@string/desc_registrar_actualizacion" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
