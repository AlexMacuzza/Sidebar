<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ventas_list"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text=" Id Venta:"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />
        <TextView
            android:id="@+id/txtidfv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight=".8"
            android:text="Id Venta"
            android:textSize="17sp"
            tools:ignore="HardcodedText" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text=" Cliente:"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />
        <TextView
            android:id="@+id/txtcliente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight=".8"
            android:text="Cliente"
            android:textSize="17sp"
            tools:ignore="HardcodedText" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text=" Dirección:"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText"
            android:visibility="gone"/>
        <TextView
            android:id="@+id/txtdircl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight=".8"
            android:text="Dirección"
            android:textSize="17sp"
            tools:ignore="HardcodedText"
            android:visibility="gone"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" Fecha:             "
            android:textSize="17sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/txtfecha"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="Fecha"
            android:textSize="17sp"
            tools:ignore="HardcodedText" />

        <TextView
            android:layout_width  ="wrap_content"
            android:layout_height ="wrap_content"
            android:text="Vence:   "
            android:textSize="17sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />
        <TextView
            android:id="@+id/txtplazo"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="Vence"
            android:textSize="17sp"
            tools:ignore="HardcodedText" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text=" Vendedor:"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />
        <TextView
            android:id="@+id/txtvendedor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight=".8"
            android:text="Vendedor"
            android:textSize="17sp"
            tools:ignore="HardcodedText" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text=" Cobrador:"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />
        <TextView
            android:id="@+id/txtcobrador"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight=".8"
            android:text="Cobrador"
            android:textSize="17sp"
            tools:ignore="HardcodedText" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text=" Descripción:"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText"
            android:visibility="visible"/>
        <TextView
            android:id="@+id/txtdesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight=".8"
            android:text="Descripción"
            android:textSize="17sp"
            tools:ignore="HardcodedText"
            android:visibility="visible"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" Monto:             "
            android:textSize="17sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />
        <TextView
            android:id="@+id/txtmonto"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="Monto"
            android:textSize="17sp"
            tools:ignore="HardcodedText" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" Saldo:   "
            android:textSize="17sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />
        <TextView
            android:id="@+id/txtsaldo"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="Saldo"
            android:textSize="17sp"
            tools:ignore="HardcodedText" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" Mora:                "
            android:textSize="17sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText"
            android:visibility="gone"/>
        <TextView
            android:id="@+id/txtmora"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="Mora"
            android:textSize="17sp"
            tools:ignore="HardcodedText"
            android:visibility="gone"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" Cuotas P: "
            android:textSize="17sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText"
            android:visibility="gone"/>
        <TextView
            android:id="@+id/txtncuotas"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:text="#c"
            android:textSize="17sp"
            tools:ignore="HardcodedText"
            android:visibility="gone"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" Score:               "
            android:textSize="17sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText"
            android:visibility="gone"/>
        <TextView
            android:id="@+id/txtscore"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="Score"
            android:textSize="17sp"
            tools:ignore="HardcodedText"
            android:visibility="gone"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" Cuota: "
            android:textSize="17sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText"
            android:visibility="gone"/>
        <TextView
            android:id="@+id/txtvcuotas"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:text="Cuota"
            android:textSize="17sp"
            tools:ignore="HardcodedText"
            android:visibility="gone"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <ImageButton
            android:id="@+id/bteliminar"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_alignParentStart="true"
            android:layout_marginStart="118dp"
            android:background="@null"
            android:contentDescription="Eliminar"
            android:gravity="center"
            android:scaleType="centerCrop"
            android:src="@drawable/eliminar"
            tools:ignore="HardcodedText,ObsoleteLayoutParam" />
    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginEnd="10dp"
        android:background="@color/black" />
</LinearLayout>