<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_nueva_mercancia"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".NuevaMercanciaFragment">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/titulo6"
        android:gravity="center"
        android:textSize="20sp"
        android:textStyle="bold"/>

    <EditText
        android:id="@+id/txtdesc"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="@string/txtdesc"
        android:inputType="text"
        tools:ignore="Autofill" />

    <EditText
        android:id="@+id/txtprecioc"
        android:layout_width="150dp"
        android:layout_height="48dp"
        android:hint="@string/txtprecioc"
        android:maxLength="10"
        android:inputType="number"
        tools:ignore="Autofill" />

    <EditText
        android:id="@+id/txtpreciov"
        android:layout_width="150dp"
        android:layout_height="48dp"
        android:hint="@string/txtpreciov"
        android:maxLength="10"
        android:inputType="number"
        tools:ignore="Autofill" />

    <EditText
        android:id="@+id/txtcantidad"
        android:layout_width="150dp"
        android:layout_height="48dp"
        android:hint="@string/txtcantidad"
        android:maxLength="10"
        android:inputType="number"
        tools:ignore="Autofill" />
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

    <ImageButton
        android:id="@+id/btguardar"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_alignParentStart="true"
        android:layout_marginStart="51dp"
        android:background="@null"
        android:gravity="center"
        android:scaleType="centerCrop"
        android:src="@drawable/aceptar" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </RelativeLayout>

</LinearLayout>