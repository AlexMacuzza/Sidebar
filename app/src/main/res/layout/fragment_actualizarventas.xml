<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_actventa"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ActualizarVentasFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="4dp">
        <!-- ── Título ─────────────────────────────────────────────── -->
        <TextView
            android:id="@+id/lblvd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Vendedor"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/teal_700"
            android:visibility="gone" />
        <!-- ── Sección: Buscar factura ────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Número de Venta"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Caja para ingresar el número de factura -->
            <EditText
                android:id="@+id/txtNumVenta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:hint="N° de venta"
                android:imeOptions="actionSearch"
                android:inputType="number"
                android:maxLength="10"
                tools:ignore="Autofill" />

            <!-- Botón buscar factura -->
            <ImageButton
                android:id="@+id/btnBuscarVenta"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@null"
                android:contentDescription="Buscar venta"
                android:scaleType="centerCrop"
                android:src="@drawable/buscarcliente"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Cliente asociado a la venta (solo lectura) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cliente: "
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtidcl"
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:hint="Id"
                android:enabled="false"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtcliente"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="Nombre"
                android:enabled="false"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/teal_700" />

        <!-- ── Sección: Agregar Productos ─────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Agregar Productos"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnmercancia"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_marginEnd="8dp"
                android:background="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/buscarmercancia"
                android:contentDescription="Agregar mercancía" />
        </LinearLayout>

        <!-- RecyclerView de productos de la venta -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/idRecycler"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:scrollbars="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/teal_700" />

        <!-- ── Sección: Subtotales ────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Subtotales"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="       Total         "
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="   Valor Pagado    "
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="     Saldo    "
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/txtventat"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:maxLength="10" />

            <EditText
                android:id="@+id/txtvpagado"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:maxLength="10"
                android:textColorHint="#546E7A"
                tools:ignore="Autofill" />

            <EditText
                android:id="@+id/txtsaldo"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:inputType="number"
                android:maxLength="10"
                android:textColorHint="#546E7A"
                tools:ignore="Autofill,SpeakableTextPresentCheck" />

            <ImageButton
                android:id="@+id/btnborrar"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:background="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/delete"
                android:contentDescription="Limpiar"
                tools:ignore="TouchTargetSizeCheck" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/teal_700" />

        <!-- ── Sección: Cuotas y Fechas ───────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Cuotas y Fechas de Cobro"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Forma de Pago       "
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text=" Valor Cuota        "
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="   Cuotas            "
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/spnrfpago"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:entries="@array/options_fpago"
                tools:ignore="TouchTargetSizeCheck" />

            <EditText
                android:id="@+id/txtctanormal"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:maxLength="10" />

            <EditText
                android:id="@+id/txtnctas"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:inputType="number" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Vencimiento     "
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="   Fecha de Cobro    "
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lblobs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="   Observaciones    "
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/txtfechav"
                android:layout_width="120dp"
                android:layout_height="48dp"
                android:enabled="false"
                android:inputType="text" />

            <EditText
                android:id="@+id/txtfechacobro"
                android:layout_width="120dp"
                android:layout_height="48dp"
                android:clickable="true"
                android:focusable="false"
                android:hint="Fecha cobro" />

            <EditText
                android:id="@+id/txtobs"
                android:layout_width="150dp"
                android:layout_height="48dp"
                android:focusable="true"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/teal_700" />

        <!-- ── Botón guardar ──────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btregistrarv"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginEnd="16dp"
                android:background="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/aceptar"
                android:contentDescription="Registrar actualización" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
